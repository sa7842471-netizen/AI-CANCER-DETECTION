# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyc
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual Environments ──────────────────────────────────────────────────────
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# ── Environment & Secrets (NEVER commit these) ────────────────────────────────
backend/.env
*.env
.env.local
.env.*.local

# ── API Keys / Service Accounts ───────────────────────────────────────────────
backend/firebase_service_account.json
*service_account*.json
*credentials*.json

# ── Database Files ────────────────────────────────────────────────────────────
backend/*.db
backend/*.sqlite
backend/*.sqlite3
*.db-journal

# ── Trained Model Weights ─────────────────────────────────────────────────────
backend/models/*.h5
backend/models/*.pt
backend/models/*.pth
backend/models/*.pkl
backend/models/*.pb
# Keep the models/ directory structure
!backend/models/.gitkeep

# ── NSL-KDD Dataset (large files) ─────────────────────────────────────────────
backend/data/*.txt
backend/data/*.csv
backend/data/*.arff
# Keep the data/ directory structure
!backend/data/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
backend/logs/*.log
logs/
*.log

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ── Test Artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.cover
.hypothesis/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints

