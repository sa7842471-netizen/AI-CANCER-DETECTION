# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration — OncoAI Multi-Cancer Detection System
# Batch 2026-27 | Odd Semester | 7th Sem
# ─────────────────────────────────────────────────────────────────────────────

# ── AI API Keys (FREE TIER) ──────────────────────────────────────────────────
# HuggingFace: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# Groq (LLaMA 3.1-70B): https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── JWT Session Security ──────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY_MINUTES=30

# ── OTP / 2FA ────────────────────────────────────────────────────────────────
# Twilio (SMS OTP): https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
OTP_EXPIRY_SECONDS=300

# ── AES-256 Encryption ───────────────────────────────────────────────────────
# 32-byte hex key: python -c "import os; print(os.urandom(32).hex())"
AES_ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# ── Firebase ─────────────────────────────────────────────────────────────────
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_SERVICE_ACCOUNT_PATH=backend/firebase_service_account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (local, default) — path relative to backend/
SQLITE_DB_PATH=onco_ai.db

# MySQL (specialist review workflows — optional production upgrade)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=oncoai_user
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=oncoai_db

# ── AI-IDS (Intrusion Detection) ─────────────────────────────────────────────
# Network interface to monitor (use 'lo' on Linux, 'Ethernet' on Windows)
IDS_NETWORK_INTERFACE=lo
IDS_MODEL_PATH=backend/models/ids_nslkdd_model.h5
IDS_ALERT_LOG_PATH=backend/logs/ids_alerts.log

# ── DPDPA 2023 Compliance ─────────────────────────────────────────────────────
DATA_RETENTION_DAYS=365
ANONYMIZE_ON_EXPORT=true

# ── Flask Configuration ───────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
FLASK_PORT=5000
CORS_ORIGINS=http://localhost:5500,http://localhost:3000
